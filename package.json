{
  "name": "@dsaasfr/vue",
  "version": "0.0.0-development",
  "description": "Composants Vue 3 orientés application (SaaS, back-office) construits sur Vue DSFR et le Système de Design de l'État (DSFR). Projet expérimental, non officiel.",
  "keywords": [
    "vue",
    "vue3",
    "dsfr",
    "vue-dsfr",
    "design-system",
    "systeme-de-design-de-l-etat",
    "rgaa",
    "accessibilite",
    "saas",
    "back-office"
  ],
  "homepage": "https://theocampbell.github.io/DSaasFR/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theocampbell/DSaasFR.git"
  },
  "bugs": {
    "url": "https://github.com/theocampbell/DSaasFR/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/dsaasfr.js",
  "module": "./dist/dsaasfr.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/dsaasfr.js"
      }
    },
    "./styles": {
      "import": {
        "types": "./types/styles.d.ts",
        "default": "./dist/dsaasfr.css"
      }
    },
    "./dist/dsaasfr.css": {
      "import": {
        "types": "./types/styles.d.ts",
        "default": "./dist/dsaasfr.css"
      }
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "build": "node ci/types.mjs clean && vite build && vue-tsc -p tsconfig.build.json && node ci/types.mjs extras",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm lint && pnpm typecheck && pnpm check-exports && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check",
    "test:coverage": "vitest run --coverage",
    "check-exports": "node ci/check-exports.mjs",
    "test:consumer": "node ci/consumer-test.mjs",
    "test:consumer:latest": "node ci/consumer-test.mjs --latest",
    "prepare": "husky",
    "semantic-release": "semantic-release",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "@gouvfr/dsfr": "~1.14.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@gouvfr/dsfr": "~1.14.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@iconify/vue": "^5.0.5",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axe-core": "^4.14.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "next",
        "prerelease": true,
        "channel": "next"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": false
            },
            {
              "type": "style",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "✨ Nouvelles fonctionnalités"
              },
              {
                "type": "fix",
                "section": "🐛 Corrections de bugs"
              },
              {
                "type": "docs",
                "section": "📚 Documentation"
              },
              {
                "type": "perf",
                "section": "⚡ Améliorations de performance"
              },
              {
                "type": "revert",
                "section": "⏪ Annulations"
              },
              {
                "type": "ci",
                "section": "👷 CI/CD"
              },
              {
                "type": "test",
                "section": "✅ Tests"
              },
              {
                "type": "refactor",
                "hidden": true
              },
              {
                "type": "style",
                "hidden": true
              },
              {
                "type": "chore",
                "hidden": true
              }
            ]
          }
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "lint-staged": {
    "*.{vue,ts,js,mjs}": "eslint",
    "src/**/*.{vue,css}": "stylelint"
  }
}
