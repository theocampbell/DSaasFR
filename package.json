{
  "name": "dsaasfr",
  "version": "0.0.0",
  "description": "SaaS-oriented Vue 3 components built on top of Vue DSFR and the Système de Design de l'État (DSFR).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/dsaasfr.js",
  "module": "./dist/dsaasfr.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./dist/dsaasfr.js"
      }
    },
    "./styles": {
      "import": "./dist/dsaasfr.css"
    },
    "./dist/dsaasfr.css": {
      "import": "./dist/dsaasfr.css"
    }
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@gouvminint/vue-dsfr": "^8.21.0",
    "vue": "^3.5.27",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@gouvfr/dsfr": "~1.14.4",
    "@gouvminint/vue-dsfr": "^8.21.0",
    "@iconify/vue": "^5.0.5",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
